# Firebase (required)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=
=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Optional media CDN override
EXPO_PUBLIC_SUPABASE_CDN_URL=

# Zego calls (required for in-app calling)
EXPO_PUBLIC_ZEGO_APP_ID=
EXPO_PUBLIC_ZEGO_APP_SIGN=
EXPO_PUBLIC_ZEGO_PUSH_RESOURCE_ID=zego_call

# Safety gate: keep direct client push disabled in production.
EXPO_PUBLIC_ENABLE_CLIENT_PUSH_SEND=false


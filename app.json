{
  "expo": {
    "name": "Bumby",
    "slug": "bumby",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/Images/bumbylogo.png",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Images/bumbylogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.offcial.social",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Bumby to use your camera for video calls.",
        "NSMicrophoneUsageDescription": "Allow Bumby to use your microphone for voice and video calls.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Images/bumbylogo.png",
        "backgroundColor": "#000000"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.offcial.social",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "MANAGE_OWN_CALLS",
        "ACCESS_NOTIFICATION_POLICY",
        "WAKE_LOCK",
        "VIBRATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./public/favicon.ico",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "884a38af-642d-4ee4-bc42-1ce208a78b6a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "./plugins/withZegoCallKit",
      [
        "expo-notifications",
        {
          "icon": "./public/notification-icon.png",
          "color": "#EC4899",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bumby to access your photos so you can set a profile picture.",
          "cameraPermission": "Allow Bumby to use your camera so you can take a profile picture."
        }
      ]
    ],
    "owner": "officialcompanynow"
  }
}
